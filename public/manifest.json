{
  "manifest_version": 3,
  "name": "Hushfern - On-device Moderator",
  "version": "1.2.2",
  "minimum_chrome_version": "116",
  "description": "Private, on-device toxicity moderation with adjustable blurring and local analytics.",
  "permissions": ["storage", "offscreen", "scripting"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hushfern controls"
  },
  "options_page": "analytics.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
